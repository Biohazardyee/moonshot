<?xml version="1.0" encoding="UTF-8" ?>
<Shell    x:Class="Moonshot.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:Moonshot"
    xmlns:pages="clr-namespace:Moonshot.Pages"
    Title="Moonshot"><!-- Initial login/register shell content -->
    <TabBar Route="auth">
        <Tab>
            <ShellContent
                Title="Register"
                ContentTemplate="{DataTemplate pages:RegisterPage}"
                Route="register" />

            <ShellContent
                Title="Login"
                ContentTemplate="{DataTemplate pages:LoginPage}"
                Route="login" />
        </Tab>
    </TabBar>

    <!-- Main app shell content (will be shown after authentication) -->
    <TabBar Route="main">
        <Tab Title="Main Menu" Icon="home">
            <ShellContent
                Title="Menu"
                ContentTemplate="{DataTemplate pages:MenuPage}"
                Route="menu" />
        </Tab>
        <!-- Add more tabs here as needed -->
    </TabBar>

</Shell>
